generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  username  String   @unique
  email     String   @unique
  password  String
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role              Role               @relation(fields: [roleId], references: [id])
  documentReceipts  DocumentReceipt[]

  @@map("users")
}

model Subsidiary {
  id                       String                 @id @default(uuid()) @db.Uuid
  title                    String                 @unique
  name                     String                 @unique
  logo                     String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  documentReceiptDetails   DocumentReceiptDetail[]

  @@map("subsidiaries")
}

model DocType {
  id                       String                 @id @default(uuid()) @db.Uuid
  title                    String                 @unique
  description              String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  documentReceipts         DocumentReceipt[]

  @@map("doc_types")
}

model Partner {
  id                       String                 @id @default(uuid()) @db.Uuid
  name                     String                 @unique
  description              String?
  type                     String
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  documentReceiptDetails   DocumentReceiptDetail[]

  @@map("partners")
}

model Box {
  id              String             @id @default(uuid()) @db.Uuid
  noBox           String             @unique @map("no_box")
  title           String?
  description     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  documentReceipts DocumentReceipt[]

  @@map("boxes")
}

model DocumentReceipt {
  id            String   @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  userId        String   @db.Uuid
  docTypeId     String   @db.Uuid
  boxId         String   @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User                   @relation(fields: [userId], references: [id])
  docType       DocType                @relation(fields: [docTypeId], references: [id])
  box           Box                    @relation(fields: [boxId], references: [id])
  details       DocumentReceiptDetail[]

  @@map("document_receipts")
}

model DocumentReceiptDetail {
  id                  String   @id @default(uuid()) @db.Uuid
  documentReceiptId   String   @db.Uuid
  subsidiaryId        String   @db.Uuid
  partnerId           String   @db.Uuid
  nomorDoc            String?
  nomorFaktur         String?
  nomorPl             String?
  nomorDo             String?
  nomorInv            String?
  nomorPv             String?
  nomorNota           String?
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  documentReceipt DocumentReceipt @relation(fields: [documentReceiptId], references: [id])
  subsidiary      Subsidiary      @relation(fields: [subsidiaryId], references: [id])
  partner         Partner         @relation(fields: [partnerId], references: [id])

  @@map("document_receipt_details")
}
